APP_VERSION=0.1.0
MAX_DID_DOCUMENT_BYTES=16384
MAX_CREDENTIAL_BYTES=32768
MAX_CREDENTIAL_REQUEST_BYTES=36864
MAX_AUTH_REQUEST_BYTES=4096
MAX_REVOCATION_REQUEST_BYTES=4096
MAX_PRESENTATION_REQUEST_BYTES=69632
MAX_JSON_DEPTH=32
DID_NETWORK_RESOLUTION_ENABLED=false
IDENTITY_ENVIRONMENT=development
IDENTITY_AUTH_ENABLED=true
IDENTITY_AUTH_JWT_ISSUER=secure-ssi-identity-service
IDENTITY_AUTH_JWT_AUDIENCE=identity-service
IDENTITY_AUTH_ACCESS_TOKEN_SECONDS=900
IDENTITY_AUTH_JWT_ALGORITHM=HS256
IDENTITY_AUTH_JWT_SECRET=
IDENTITY_AUTH_FIXTURE_USERS_ENABLED=true
IDENTITY_AUTH_CLOCK_SKEW_SECONDS=10
IDENTITY_AUTH_USER_PROVIDER=mongodb
IDENTITY_MONGO_ENABLED=true
# Leave empty to build it from MONGO_APP_PASSWORD (docker-compose). If set, its password must match.
IDENTITY_MONGO_URI=mongodb://identity_app:change-me-app@mongodb:27017/secure_identity?authSource=secure_identity
IDENTITY_MONGO_DATABASE=secure_identity
IDENTITY_MONGO_SERVER_SELECTION_TIMEOUT_MS=3000
IDENTITY_MONGO_CONNECT_TIMEOUT_MS=3000
IDENTITY_MONGO_SOCKET_TIMEOUT_MS=5000
IDENTITY_MONGO_MAX_POOL_SIZE=50
IDENTITY_MONGO_MIN_POOL_SIZE=0
IDENTITY_MONGO_RETRY_READS=true
IDENTITY_MONGO_RETRY_WRITES=true
IDENTITY_MONGO_APP_NAME=secure-ssi-identity-service
IDENTITY_STATUS_LIST_PUBLIC_BASE_URL=http://localhost:8001/api/v1/status-lists
IDENTITY_STATUS_LIST_LENGTH=131072
IDENTITY_STATUS_LIST_CAPACITY=131072
IDENTITY_STATUS_LIST_TTL_SECONDS=300
IDENTITY_AUDIT_OUTBOX_ENABLED=true
IDENTITY_AUDIT_OUTBOX_POLL_INTERVAL_MS=1000
IDENTITY_AUDIT_OUTBOX_BATCH_SIZE=100
IDENTITY_AUDIT_OUTBOX_BASE_RETRY_SECONDS=1
IDENTITY_AUDIT_OUTBOX_MAX_RETRY_SECONDS=300
IDENTITY_AUDIT_OUTBOX_LEASE_SECONDS=30
IDENTITY_PRESENTATION_CHALLENGE_LIFETIME_SECONDS=300
IDENTITY_PRESENTATION_RECONCILIATION_ENABLED=true
IDENTITY_PRESENTATION_RECONCILIATION_STALE_SECONDS=60
IDENTITY_PRESENTATION_RECONCILIATION_POLL_INTERVAL_MS=1000
IDENTITY_PRESENTATION_RECONCILIATION_BATCH_SIZE=100
# Development provider is deterministic, process-local, and NOT production KMS/HSM.
IDENTITY_KMS_ENABLED_PROVIDERS=development
IDENTITY_KMS_DEFAULT_PROVIDER=development
IDENTITY_KMS_ALLOWED_ALGORITHMS=Ed25519
IDENTITY_KMS_DEVELOPMENT_PROVIDER_ENABLED=true
IDENTITY_KMS_PROHIBIT_DEVELOPMENT_IN_PRODUCTION=true
IDENTITY_KMS_REMOTE_PROVIDER_NAME=remote-kms
IDENTITY_KMS_REMOTE_BASE_URL=
IDENTITY_KMS_REMOTE_AUTH_TOKEN_ENV=IDENTITY_KMS_REMOTE_AUTH_TOKEN
IDENTITY_KMS_REMOTE_AUTH_TOKEN=
IDENTITY_KMS_CONNECT_TIMEOUT_SECONDS=2
IDENTITY_KMS_REQUEST_TIMEOUT_SECONDS=5
IDENTITY_KMS_RETRY_COUNT=2
IDENTITY_KMS_RETRY_BACKOFF_MS=100
IDENTITY_KMS_TLS_VERIFY=true
IDENTITY_KMS_CLIENT_CERTIFICATE_PATH=
IDENTITY_KMS_CLIENT_KEY_PATH=
IDENTITY_KMS_CIRCUIT_FAILURE_THRESHOLD=5
IDENTITY_KMS_CIRCUIT_RESET_SECONDS=30
IDENTITY_KMS_ROTATION_INTERVAL_DAYS=90
IDENTITY_KMS_ROTATION_GRACE_SECONDS=0
IDENTITY_KMS_DESTRUCTION_DELAY_HOURS=24
IDENTITY_KMS_RECONCILIATION_ENABLED=true
IDENTITY_KMS_RECONCILIATION_INTERVAL_MS=1000
IDENTITY_KMS_RECONCILIATION_BATCH_SIZE=100
IDENTITY_KMS_STALE_OPERATION_SECONDS=60
IDENTITY_KMS_RECONCILIATION_LEASE_SECONDS=30
IDENTITY_KMS_RECONCILIATION_RETRY_LIMIT=5
IDENTITY_RECOVERY_GRANT_ISSUER=secure-ssi-recovery-service
IDENTITY_RECOVERY_GRANT_AUDIENCE=identity-service-recovery
IDENTITY_RECOVERY_GRANT_SECRET=
IDENTITY_RECOVERY_GRANT_LIFETIME_SECONDS=60
IDENTITY_RECOVERY_GRANT_CLOCK_SKEW_SECONDS=5
# WP-28 platform backup. Keep disabled unless a dedicated key is generated:
# python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# The key must not be a database credential and must be stored separately from backups.
IDENTITY_PLATFORM_BACKUP_ENABLED=false
IDENTITY_PLATFORM_BACKUP_KEY_BASE64=
IDENTITY_PLATFORM_BACKUP_RETENTION_SECONDS=604800
RECOVERY_ENVIRONMENT=development
RECOVERY_MONGO_ENABLED=true
# Leave empty to build it from MONGO_RECOVERY_PASSWORD (docker-compose). If set, its password must match.
RECOVERY_MONGO_URI=mongodb://recovery_app:change-me-recovery@mongodb:27017/secure_recovery?authSource=secure_recovery
RECOVERY_MONGO_DATABASE=secure_recovery
RECOVERY_MONGO_TIMEOUT_MS=3000
RECOVERY_AUTH_JWT_ISSUER=secure-ssi-identity-service
RECOVERY_AUTH_JWT_AUDIENCE=identity-service
RECOVERY_AUTH_JWT_ALGORITHM=HS256
# Not read by docker-compose: the recovery service receives IDENTITY_AUTH_JWT_SECRET.
RECOVERY_AUTH_JWT_SECRET=
RECOVERY_AUTH_CLOCK_SKEW_SECONDS=10
RECOVERY_IDENTITY_BASE_URL=http://identity-service:8000
RECOVERY_IDENTITY_GRANT_ISSUER=secure-ssi-recovery-service
RECOVERY_IDENTITY_GRANT_AUDIENCE=identity-service-recovery
# Not read by docker-compose: the recovery service receives IDENTITY_RECOVERY_GRANT_SECRET.
RECOVERY_IDENTITY_GRANT_SECRET=
RECOVERY_IDENTITY_GRANT_LIFETIME_SECONDS=60
RECOVERY_IDENTITY_TIMEOUT_SECONDS=5
# Base64 of exactly 32 random bytes; required outside development.
RECOVERY_SHARE_ENVELOPE_KEY_BASE64=
RECOVERY_DEFAULT_MINIMUM_APPROVALS=3
RECOVERY_DEFAULT_MAXIMUM_GUARDIANS=5
RECOVERY_DEFAULT_APPROVAL_WINDOW_SECONDS=3600
RECOVERY_DEFAULT_TIME_LOCK_SECONDS=300
RECOVERY_DEFAULT_EXPIRATION_SECONDS=86400
RECOVERY_DEFAULT_MAXIMUM_ATTEMPTS=3
RECOVERY_DEFAULT_COOLDOWN_SECONDS=3600
RECOVERY_RECONCILIATION_ENABLED=true
RECOVERY_RECONCILIATION_POLL_INTERVAL_MS=1000
RECOVERY_RECONCILIATION_BATCH_SIZE=100
RECOVERY_RECONCILIATION_LEASE_SECONDS=30
RECOVERY_RECONCILIATION_STALE_SECONDS=60
MONGO_INITDB_ROOT_USERNAME=prototype
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=secure_identity
MONGO_APP_USERNAME=identity_app
MONGO_APP_PASSWORD=change-me-app
MONGO_RECOVERY_DATABASE=secure_recovery
MONGO_RECOVERY_USERNAME=recovery_app
MONGO_RECOVERY_PASSWORD=change-me-recovery
# Required for Identity Service -> Fraud Service internal evaluation/event calls.
# Use the same randomly generated value (at least 32 characters) for both services.
# Empty = docker-compose uses a published development-only token, which the
# Identity Service refuses in production-like environments.
FRAUD_INTERNAL_SERVICE_TOKEN=
FRAUD_SERVICE_URL=http://fraud-service:8000
FRAUD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5178,http://127.0.0.1:5178

# --- WP-29: all of these are forced on or required in production-like modes. ---
# Any environment name outside development, dev, local, test, testing is
# production-like, including typos and blank values.
IDENTITY_STEP_UP_REQUIRED=false
IDENTITY_DUAL_CONTROL_REQUIRED=false
RECOVERY_STEP_UP_REQUIRED=false
# Shared by Identity and Recovery. At least 32 characters.
IDENTITY_STEP_UP_SECRET=
# Leave empty to reuse IDENTITY_STEP_UP_SECRET (docker-compose does this). If set,
# it must be identical, or every recovery step-up is refused with 403.
RECOVERY_STEP_UP_SECRET=
# 32 random bytes, base64. Encrypts authenticator secrets at rest.
IDENTITY_MFA_FACTOR_KEY_BASE64=
# Issuer and status-list signing. Production-like modes must use remote-kms,
# with separate keys and separate KMS client credentials.
IDENTITY_ISSUER_KEY_PROVIDER=
IDENTITY_ISSUER_DID=
IDENTITY_ISSUER_KMS_KEY_REFERENCE=
IDENTITY_ISSUER_KMS_VERIFICATION_METHOD=
IDENTITY_ISSUER_KMS_AUTH_TOKEN_ENV=
IDENTITY_STATUS_KMS_KEY_REFERENCE=
IDENTITY_STATUS_KMS_VERIFICATION_METHOD=
IDENTITY_STATUS_KMS_AUTH_TOKEN_ENV=
# Public keys of retired issuer keys, as JSON, so old proofs stay verifiable.
IDENTITY_ISSUER_HISTORICAL_KEYS_JSON=
# Revocation ledger: a separate database principal with no update or delete
# right. The anchor must live on storage the database cannot reach.
IDENTITY_REVOCATION_LEDGER_URI=
IDENTITY_REVOCATION_LEDGER_DATABASE=secure_revocation_ledger
IDENTITY_REVOCATION_LEDGER_MAC_KEY_BASE64=
IDENTITY_REVOCATION_ANCHOR_PATH=/var/lib/secure-ssi/ledger-anchor/head.json
IDENTITY_REVOCATION_ANCHOR_BOOTSTRAP=false
MONGO_LEDGER_DATABASE=
MONGO_LEDGER_USERNAME=
MONGO_LEDGER_PASSWORD=
# Backup coverage of the recovery database, through a read-only principal.
MONGO_BACKUP_READER_USERNAME=
MONGO_BACKUP_READER_PASSWORD=
IDENTITY_PLATFORM_BACKUP_RECOVERY_URI=
IDENTITY_PLATFORM_BACKUP_INTERVAL_SECONDS=0
IDENTITY_PLATFORM_BACKUP_KMS_KEY_REFERENCE=
IDENTITY_PLATFORM_BACKUP_KMS_AUTH_TOKEN_ENV=
# Recovery floors. Production-like modes refuse anything below 2 approvals and 24 hours.
RECOVERY_MINIMUM_APPROVALS_FLOOR=2
RECOVERY_TIME_LOCK_FLOOR_SECONDS=60
RECOVERY_GUARDIAN_CHANGE_DELAY_SECONDS=300
RECOVERY_FRAUD_SERVICE_URL=http://fraud-service:8000
# Origin a phone can reach, e.g. https://wallet.example.org. Empty means no phone QR.
IDENTITY_PUBLIC_ORIGIN=

# OpenID4VP signed requests (request_uri + JAR). base64url Ed25519 private seed,
# 32 bytes. Required in production-like environments. Left empty in development,
# the service makes a key that lasts until it restarts.
# Generate: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).rstrip(b'=').decode())"
OID4VP_REQUEST_SIGNING_KEY=
# Passkeys. Empty means security keys are not available. Production needs HTTPS.
IDENTITY_WEBAUTHN_RP_ID=
IDENTITY_WEBAUTHN_ORIGIN=

# Security intelligence. A store it cannot reach shows as UNAVAILABLE, never as zero.
MONGO_INTEL_DATABASE=secure_security_intel
MONGO_INTEL_USERNAME=intel_app
MONGO_INTEL_PASSWORD=
FRAUD_INTEL_MONGO_URI=
# 32+ characters, shared by Gateway, Identity and Recovery. Keep it out of the fraud service.
SECURITY_EVENT_PSEUDONYM_KEY=
# OPERATIONAL, or SYNTHETIC_TEST on test stacks. Analytics never mix the two.
SECURITY_EVENT_ORIGIN=OPERATIONAL
INTEL_ANALYTICS_ORIGIN=OPERATIONAL
