APP_VERSION=0.1.0
MAX_DID_DOCUMENT_BYTES=16384
MAX_CREDENTIAL_BYTES=32768
MAX_CREDENTIAL_REQUEST_BYTES=36864
MAX_AUTH_REQUEST_BYTES=4096
MAX_REVOCATION_REQUEST_BYTES=4096
MAX_PRESENTATION_REQUEST_BYTES=69632
MAX_JSON_DEPTH=32
DID_NETWORK_RESOLUTION_ENABLED=false
IDENTITY_ENVIRONMENT=development
IDENTITY_AUTH_ENABLED=true
IDENTITY_AUTH_JWT_ISSUER=secure-ssi-identity-service
IDENTITY_AUTH_JWT_AUDIENCE=identity-service
IDENTITY_AUTH_ACCESS_TOKEN_SECONDS=900
IDENTITY_AUTH_JWT_ALGORITHM=HS256
IDENTITY_AUTH_JWT_SECRET=
IDENTITY_AUTH_FIXTURE_USERS_ENABLED=true
IDENTITY_AUTH_CLOCK_SKEW_SECONDS=10
IDENTITY_AUTH_USER_PROVIDER=synthetic
IDENTITY_MONGO_ENABLED=true
IDENTITY_MONGO_URI=mongodb://identity_app:change-me-app@mongodb:27017/secure_identity?authSource=secure_identity
IDENTITY_MONGO_DATABASE=secure_identity
IDENTITY_MONGO_SERVER_SELECTION_TIMEOUT_MS=3000
IDENTITY_MONGO_CONNECT_TIMEOUT_MS=3000
IDENTITY_MONGO_SOCKET_TIMEOUT_MS=5000
IDENTITY_MONGO_MAX_POOL_SIZE=50
IDENTITY_MONGO_MIN_POOL_SIZE=0
IDENTITY_MONGO_RETRY_READS=true
IDENTITY_MONGO_RETRY_WRITES=true
IDENTITY_MONGO_APP_NAME=secure-ssi-identity-service
IDENTITY_STATUS_LIST_PUBLIC_BASE_URL=http://localhost:8001/api/v1/status-lists
IDENTITY_STATUS_LIST_LENGTH=131072
IDENTITY_STATUS_LIST_CAPACITY=131072
IDENTITY_STATUS_LIST_TTL_SECONDS=300
IDENTITY_AUDIT_OUTBOX_ENABLED=true
IDENTITY_AUDIT_OUTBOX_POLL_INTERVAL_MS=1000
IDENTITY_AUDIT_OUTBOX_BATCH_SIZE=100
IDENTITY_AUDIT_OUTBOX_BASE_RETRY_SECONDS=1
IDENTITY_AUDIT_OUTBOX_MAX_RETRY_SECONDS=300
IDENTITY_AUDIT_OUTBOX_LEASE_SECONDS=30
IDENTITY_PRESENTATION_CHALLENGE_LIFETIME_SECONDS=300
IDENTITY_PRESENTATION_RECONCILIATION_ENABLED=true
IDENTITY_PRESENTATION_RECONCILIATION_STALE_SECONDS=60
IDENTITY_PRESENTATION_RECONCILIATION_POLL_INTERVAL_MS=1000
IDENTITY_PRESENTATION_RECONCILIATION_BATCH_SIZE=100
MONGO_INITDB_ROOT_USERNAME=prototype
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=secure_identity
MONGO_APP_USERNAME=identity_app
MONGO_APP_PASSWORD=change-me-app
