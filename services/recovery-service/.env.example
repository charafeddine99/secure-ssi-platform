APP_VERSION=0.1.0
RECOVERY_ENVIRONMENT=development
RECOVERY_MONGO_ENABLED=false
RECOVERY_MONGO_URI=mongodb://recovery_app:change-me-recovery@localhost:27017/secure_recovery?authSource=secure_recovery
RECOVERY_MONGO_DATABASE=secure_recovery
RECOVERY_MONGO_TIMEOUT_MS=3000
RECOVERY_AUTH_JWT_ISSUER=secure-ssi-identity-service
RECOVERY_AUTH_JWT_AUDIENCE=identity-service
RECOVERY_AUTH_JWT_ALGORITHM=HS256
RECOVERY_AUTH_JWT_SECRET=
RECOVERY_AUTH_CLOCK_SKEW_SECONDS=10
RECOVERY_IDENTITY_BASE_URL=http://localhost:8001
RECOVERY_IDENTITY_GRANT_ISSUER=secure-ssi-recovery-service
RECOVERY_IDENTITY_GRANT_AUDIENCE=identity-service-recovery
RECOVERY_IDENTITY_GRANT_SECRET=
RECOVERY_IDENTITY_GRANT_LIFETIME_SECONDS=60
RECOVERY_IDENTITY_TIMEOUT_SECONDS=5
# Base64 of exactly 32 random bytes; required outside development.
RECOVERY_SHARE_ENVELOPE_KEY_BASE64=
RECOVERY_DEFAULT_MINIMUM_APPROVALS=3
RECOVERY_DEFAULT_MAXIMUM_GUARDIANS=5
RECOVERY_DEFAULT_APPROVAL_WINDOW_SECONDS=3600
RECOVERY_DEFAULT_TIME_LOCK_SECONDS=300
RECOVERY_DEFAULT_EXPIRATION_SECONDS=86400
RECOVERY_DEFAULT_MAXIMUM_ATTEMPTS=3
RECOVERY_DEFAULT_COOLDOWN_SECONDS=3600
RECOVERY_RECONCILIATION_ENABLED=true
RECOVERY_RECONCILIATION_POLL_INTERVAL_MS=1000
RECOVERY_RECONCILIATION_BATCH_SIZE=100
RECOVERY_RECONCILIATION_LEASE_SECONDS=30
RECOVERY_RECONCILIATION_STALE_SECONDS=60
