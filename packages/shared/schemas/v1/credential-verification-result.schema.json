{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-ssi.example/schemas/v1/credential-verification-result.schema.json",
  "title": "Credential Verification Result",
  "description": "Version 1 claim-free verification result with explicit security check outcomes and machine-readable reason codes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verified",
    "verifiedAt",
    "checks",
    "reasonCodes"
  ],
  "properties": {
    "verified": {
      "type": "boolean"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentStructure",
        "contextAndType",
        "issuerDidResolution",
        "verificationMethodAuthorization",
        "proofCryptosuite",
        "proofPurpose",
        "proofTimestamp",
        "signature",
        "contentIntegrity",
        "validityWindow",
        "credentialStatus",
        "issuerTrust"
      ],
      "properties": {
        "documentStructure": {
          "$ref": "#/$defs/check"
        },
        "contextAndType": {
          "$ref": "#/$defs/check"
        },
        "issuerDidResolution": {
          "$ref": "#/$defs/check"
        },
        "verificationMethodAuthorization": {
          "$ref": "#/$defs/check"
        },
        "proofCryptosuite": {
          "$ref": "#/$defs/check"
        },
        "proofPurpose": {
          "$ref": "#/$defs/check"
        },
        "proofTimestamp": {
          "$ref": "#/$defs/check"
        },
        "signature": {
          "$ref": "#/$defs/check"
        },
        "contentIntegrity": {
          "$ref": "#/$defs/check"
        },
        "validityWindow": {
          "$ref": "#/$defs/check"
        },
        "credentialStatus": {
          "$ref": "#/$defs/check"
        },
        "issuerTrust": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      },
      "uniqueItems": true,
      "maxItems": 32
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasonCode"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "notChecked",
            "notApplicable"
          ]
        },
        "reasonCode": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        }
      }
    }
  },
  "examples": [
    {
      "verified": true,
      "verifiedAt": "2026-01-01T00:00:01Z",
      "checks": {
        "documentStructure": {
          "status": "passed",
          "reasonCode": null
        },
        "contextAndType": {
          "status": "passed",
          "reasonCode": null
        },
        "issuerDidResolution": {
          "status": "passed",
          "reasonCode": null
        },
        "verificationMethodAuthorization": {
          "status": "passed",
          "reasonCode": null
        },
        "proofCryptosuite": {
          "status": "passed",
          "reasonCode": null
        },
        "proofPurpose": {
          "status": "passed",
          "reasonCode": null
        },
        "proofTimestamp": {
          "status": "passed",
          "reasonCode": null
        },
        "signature": {
          "status": "passed",
          "reasonCode": null
        },
        "contentIntegrity": {
          "status": "passed",
          "reasonCode": null
        },
        "validityWindow": {
          "status": "passed",
          "reasonCode": null
        },
        "credentialStatus": {
          "status": "notApplicable",
          "reasonCode": null
        },
        "issuerTrust": {
          "status": "passed",
          "reasonCode": null
        }
      },
      "reasonCodes": []
    }
  ]
}
