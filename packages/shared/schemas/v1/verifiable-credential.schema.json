{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-ssi.example/schemas/v1/verifiable-credential.schema.json",
  "title": "University Affiliation Verifiable Credential",
  "description": "Version 1 synthetic VC Data Model 2.0 profile. The optional proof supports both unsigned fixtures and secured credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@context",
    "id",
    "type",
    "issuer",
    "validFrom",
    "validUntil",
    "credentialSubject"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "prefixItems": [
        {
          "const": "https://www.w3.org/ns/credentials/v2"
        },
        {
          "const": "https://secure-ssi.example/contexts/university-affiliation/v1"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "id": {
      "type": "string",
      "format": "uri",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 45
    },
    "type": {
      "type": "array",
      "prefixItems": [
        {
          "const": "VerifiableCredential"
        },
        {
          "const": "UniversityAffiliationCredential"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "issuer": {
      "type": "string",
      "pattern": "^did:web:[A-Za-z0-9._:%-]+$",
      "maxLength": 512
    },
    "validFrom": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "validUntil": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "credentialSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "affiliation",
        "programCode",
        "degree",
        "graduationYear"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^did:key:z[1-9A-HJ-NP-Za-km-z]+$",
          "maxLength": 512
        },
        "affiliation": {
          "type": "string",
          "enum": [
            "student",
            "faculty",
            "staff"
          ]
        },
        "programCode": {
          "type": "string",
          "pattern": "^SYN-[A-Z0-9-]{2,28}$",
          "maxLength": 32
        },
        "degree": {
          "type": "string",
          "enum": [
            "Bachelor of Science",
            "Master of Science",
            "Doctor of Philosophy"
          ]
        },
        "graduationYear": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        }
      }
    },
    "proof": {
      "$ref": "data-integrity-proof.schema.json"
    }
  },
  "examples": [
    {
      "@context": [
        "https://www.w3.org/ns/credentials/v2",
        "https://secure-ssi.example/contexts/university-affiliation/v1"
      ],
      "id": "urn:uuid:00000000-0000-4000-8000-000000000001",
      "type": [
        "VerifiableCredential",
        "UniversityAffiliationCredential"
      ],
      "issuer": "did:web:issuer.example",
      "validFrom": "2026-01-01T00:00:00Z",
      "validUntil": "2026-12-31T23:59:59Z",
      "credentialSubject": {
        "id": "did:key:z6Mkf5rGMoatrSj1f4CyvuHBeXJELe9RPdzo2PKGNCKVtZxP",
        "affiliation": "student",
        "programCode": "SYN-CS-001",
        "degree": "Bachelor of Science",
        "graduationYear": 2026
      }
    }
  ]
}
