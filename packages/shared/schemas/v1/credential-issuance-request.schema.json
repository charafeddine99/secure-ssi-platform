{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-ssi.example/schemas/v1/credential-issuance-request.schema.json",
  "title": "Credential Issuance Request",
  "description": "Planned version 1 boundary. It does not implement or select a credential format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["issuerDid", "subjectDid", "credentialType", "claims"],
  "properties": {
    "issuerDid": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[A-Za-z0-9._:%-]+$",
      "maxLength": 512
    },
    "subjectDid": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[A-Za-z0-9._:%-]+$",
      "maxLength": 512
    },
    "credentialType": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{2,127}$"
    },
    "claims": {
      "type": "object",
      "description": "Allowlisted claims defined by a future issuer policy.",
      "minProperties": 1,
      "maxProperties": 32
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "issuerDid": "did:example:university",
      "subjectDid": "did:example:holder123",
      "credentialType": "UniversityAffiliation",
      "claims": {"affiliation": "student"}
    }
  ]
}
